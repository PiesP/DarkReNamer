  "required_automated_gates": [
    "locked-host-gate",
    "windows-backend-source-bound",
    "candidate-package-and-provenance",
    "profile-raw-evidence-verifier",
    "immutable-promotion-binding"
  ],
  "diagnostic_only": [
    "vm-storage-performance"
  ],
  "outside_v1_claims": [
    "human-visual-and-assistive-technology-acceptance",
    "physical-device-performance",
    "physical-power-loss",
    "vm-reset-and-storage-fault",
    "actual-ime-and-explorer-drag-drop",
    "display-combinations-outside-the-fixed-required-cells"
  ],
  "failure_rules": {
    "missing_required_target": "fail",
    "target_failure": "fail",
    "evidence_gap": "fail",
    "environment_mismatch": "fail",
    "cleanup_failure": "fail",
    "retry_replaces_first_attempt": false
  },
  "required_backend_test_names": [
    "occupied_distinct_destination_is_never_replaced",
    "occupied_destination_and_relative_path_are_rejected",
    "hard_link_destination_is_never_replaced",
    "stale_source_parent_or_destination_refuses_before_journal_and_mutation",
    "active_collision_preserves_both_files_and_poisons_candidate"
  ],
  "representative_core_environment": {
    "scale_percent": 200,
    "hwnd_dpi": 192,
    "text_scale_percent": 100,
    "contrast": "normal",
    "desktop_width": 3840,
    "desktop_height": 2160
  },
  "stability": {
    "fresh_core_runs": 10,
    "recreate_managed_rdp_lease_each_run": true,
    "retain_all_attempts": true,
    "automatic_retry_replaces_first_attempt": false,
    "environment": {
      "scale_percent": 200,
      "hwnd_dpi": 192,
      "text_scale_percent": 100,
      "contrast": "normal",
      "desktop_width": 3840,
      "desktop_height": 2160
    }
  },
  "recovery": {
    "transaction_file_count": 4096,
    "protected_files": [
      "sentinel.bin"
    ],
    "identity": "FILE_ID_INFO-u64-volume-u128-file-id",
    "journal_version": 2,
    "schedule": "direct-same-parent-files",
    "torn_tail": "retain-product-supported-final-torn-frame-and-bind-valid-prefix-to-whole-state",
    "intent_candidate": "byte-identical-first-complete-intent-frame"
  },
  "binding": {
    "repository": "PiesP/DarkReNamer",
    "source_ref": "refs/heads/master",
    "candidate_workflow": ".github/workflows/release.yaml",
    "validation_workflow": ".github/workflows/vm-acceptance.yaml",
    "publication_workflow": ".github/workflows/promote-release.yaml",
    "require_product_harness_and_hosted_source_equal": true,
    "raw_evidence_visibility": "private-draft-asset",
    "public_evidence": "canonical-attested-statement-only"
  }
}
