      "id": "process-crash",
      "executor": "windows-vm-recovery-acceptance",
      "mode": "ProcessCrash",
      "recovery_export": true,
      "intent_only_candidate_discard": true,
      "fixture_count": 4096,
      "required_observations": [
        "initial",
        "quiescent_partial",
        "startup_unchanged",
        "default_cancel_unchanged",
        "restored",
        "journal_inventory",
        "process_lifecycle",
        "cleanup"
      ],
      "execution_group": "process-crash-export-intent"
    },
    {
      "id": "recovery-export",
      "execution_group": "process-crash-export-intent",
      "executor": "windows-vm-recovery-acceptance",
      "required_observations": [
        "journal_before",
        "export_bytes",
        "journal_after_exit",
        "fixture_unchanged",
        "recovery_lock",
        "cleanup"
      ]
    },
    {
      "id": "intent-only-discard",
      "execution_group": "process-crash-export-intent",
      "executor": "windows-vm-recovery-acceptance",
      "fixture_kind": "authentic-frame-injected",
      "required_observations": [
        "authentic_intent_frame",
        "injection_no_active_journal",
        "startup_and_cancel_unchanged",
        "relaunch_unchanged",
        "explicit_candidate_discard",
        "no_file_mutation",
        "journal_inventory",
        "cleanup"
      ]
    },
    {
      "id": "worker-cancellation",
      "executor": "windows-vm-recovery-acceptance",
      "mode": "WorkerCancellation",
      "fixture_count": 4096,
      "required_observations": [
        "initial",
        "partial_witness",
        "restored",
        "journal_inventory",
        "process_exit",
        "cleanup"
      ]
    },
    {
      "id": "worker-close",
      "executor": "windows-vm-recovery-acceptance",
      "mode": "WorkerClose",
      "fixture_count": 4096,
      "required_observations": [
        "initial",
        "partial_witness",
        "restored",
        "journal_inventory",
        "process_exit",
        "cleanup"
      ]
